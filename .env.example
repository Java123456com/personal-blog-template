# Copy to .env for Docker Compose. Replace every CHANGE_ME value.
APP_PORT=4173
MYSQL_LOCAL_PORT=3307
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_USER=blog_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
BLOG_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BLOG_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

# For local npm dev, also set these in .env.local:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=blog
